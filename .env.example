STASH_URL=http://192.168.0.10:9999
STASH_API_KEY=
DATABASE_URL=postgres://flix:flix@127.0.0.1:5433/flix
PORT=8080
# Stash path prefix = local mount of the same files; unset streams through Stash
MEDIA_PATH_MAP=
# Absolute origin for playback links (AirPlay receivers cannot resolve hosts-file names); unset = relative
MEDIA_ORIGIN=
# Optional login; FLIX_SESSION_SECRET is required when FLIX_PASSWORD is set
FLIX_PASSWORD=
FLIX_SESSION_SECRET=
# Built web app to serve (production image sets this)
WEB_DIST=
# Caches (defaults shown). Assets on disk under CACHE_DIR; query results in memory, saved to
# CACHE_DIR/data.json so restarts start warm. Results go stale after the TTL and are then
# served while they refresh, for up to the stale window.
CACHE_DIR=
ASSET_CACHE_MAX_MB=5120
ASSET_CACHE_TTL_HOURS=720
# Hour (UTC) to pre-fetch every screenshot, preview and sprite into the asset cache; empty disables.
WARM_AT_UTC=6
DATA_CACHE_TTL_MINUTES=360
DATA_CACHE_STALE_HOURS=168
DATA_CACHE_MAX_ENTRIES=5000
# Change check against Stash while flix is in use; 0 disables
CHANGE_POLL_SECONDS=60
